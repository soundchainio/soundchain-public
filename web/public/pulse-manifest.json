{
    "short_name": "SC Pulse",
    "name": "SoundChain Pulse",
    "description": "Encrypted messaging & notifications for SoundChain",
    "categories": ["social", "music", "communication"],
    "background_color": "#0b141a",
    "theme_color": "#00a884",
    "display": "standalone",
    "orientation": "portrait",
    "scope": "/dex/pulse",
    "start_url": "/dex/pulse",
    "icons": [
      {
          "src": "/favicons/pulse-icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
      },
      {
          "src": "/favicons/pulse-icon-512.png",
          "sizes": "512x512",
          "type": "image/png",
          "purpose": "any"
      },
      {
        "src": "/favicons/pulse-icon-192.png",
        "sizes": "192x192",
        "type": "image/png",
        "purpose": "maskable"
      },
      {
        "src": "/favicons/pulse-icon-512.png",
        "sizes": "512x512",
        "type": "image/png",
        "purpose": "maskable"
      }
    ],
    "shortcuts": [
      {
        "name": "New Message",
        "url": "/dex/pulse?new=1"
      },
      {
        "name": "Notifications",
        "url": "/dex/pulse?tab=notifications"
      }
    ],
    "share_target": {
      "action": "/dex/pulse",
      "method": "GET",
      "params": {
        "title": "title",
        "text": "text",
        "url": "url"
      }
    }
  }
