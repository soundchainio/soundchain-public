{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/agent/radio/broadcast",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/publish/agent-to-social",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/morning-report?send=true",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/fantasy-scoring",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/settle-picks",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/repin-scid",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/process-pending",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/process-auctions",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/cleanup-ephemeral",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/blockchain-watcher",
      "schedule": "*/5 * * * *"
    }
  ]
}
