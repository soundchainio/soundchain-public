[Unit]
Description=Reverse SSH tunnel to EC2 for Lucy/Norman
After=network-online.target ollama.service
Wants=network-online.target

[Service]
User=soundchain
# NOTE: real host/key/forwards live only in the deployed unit on anvil (not the public repo).
# Placeholders below — fill EC2_HOST, SSH_KEY_PATH, and the -R forwards on the box.
ExecStart=/usr/bin/ssh -NT -i <SSH_KEY_PATH> -o ServerAliveInterval=60 -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=accept-new -R 11434:localhost:11434 <EC2_USER>@<EC2_HOST>
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
