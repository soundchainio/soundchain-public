{
  "name": "@soundchain/arena",
  "version": "1.0.0",
  "private": true,
  "description": "SoundChain Arena — fantasy + 1v1 console challenges. Free-to-play. Native-ready via Capacitor.",
  "scripts": {
    "dev": "next dev -p 3001",
    "prefetch:emotes": "node scripts/fetch-emotes.mjs",
    "prebuild": "node scripts/fetch-emotes.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "vercel-build": "node scripts/fetch-emotes.mjs && next build",
    "cap:sync": "next build && next export && npx cap sync",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:ios:build": "next build && next export && npx cap sync ios && npx cap open ios",
    "cap:android:build": "next build && next export && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@giphy/js-fetch-api": "^5.7.0",
    "@giphy/react-components": "^10.1.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.453.0",
    "mongodb": "^6.3.0",
    "next": "13.5.6",
    "next-pwa": "^5.6.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "styled-components": "^6.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  }
}
